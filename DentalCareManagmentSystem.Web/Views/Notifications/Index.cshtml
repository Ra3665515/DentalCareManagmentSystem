@model List<DentalCareManagmentSystem.Application.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "Today's Appointments";
    var isDoctor = User.IsInRole("Doctor");
    var isReceptionist = User.IsInRole("Receptionist");
}

<div class="container-fluid py-4">
    <!-- مكان عرض الـ Partial View -->
    <div id="todaysAppointmentsContainer">
        @await Html.PartialAsync("_TodayNotifications", Model)
    </div>
</div>
@if (isReceptionist)
{
    <div class="row mb-4">
        <div class="col-12">
            <!-- زر الاختبار -->
            <div class="text-center mb-3">
                <button class="btn btn-warning btn-sm" onclick="testCallNext()">
                    <i class="fas fa-vial me-1"></i> Test Call Next
                </button>
            </div>

            <div class="card border-warning shadow-sm">
                <!-- باقي الكود -->
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.25/signalr.min.js"></script>
    <script>
        // تعريف المتغيرات العالمية
        let receptionConnection = null;
        let doctorConnection = null;
        let currentAppointmentId = null;

        // دالة لتهيئة النظام
        function initializeQueueSystem() {
            console.log('✅ Initializing queue system...');

            if (typeof signalR === 'undefined') {
                console.error('❌ SignalR not loaded');
                return;
            }

            // إعداد أزرار الإضافة للطابور
            initializeQueueButtons();

            @if (isReceptionist)
            {
                    <text>
                    console.log('👩‍💼 Initializing reception connection...');
                    initializeReceptionConnection();
                    </text>
            }

            @if (isDoctor)
            {
                    <text>
                    console.log('👨‍⚕️ Initializing doctor connection...');
                    initializeDoctorConnection();
                    </text>
            }
        }

        function initializeReceptionConnection() {
            try {
                receptionConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect([0, 1000, 5000, 10000])
                    .build();

                receptionConnection.start()
                    .then(() => {
                        console.log("✅ Reception connected to SignalR");
                        return receptionConnection.invoke("JoinReceptionRoom");
                    })
                    .then(() => {
                        console.log("✅ Reception joined room successfully");
                    })
                    .catch(err => {
                        console.error('❌ Reception Connection Error: ', err);
                    });

                receptionConnection.on("UpdateQueue", (queue) => {
                    console.log("📋 Queue updated:", queue);
                    updateReceptionQueueDisplay(queue);
                });

                receptionConnection.on("PatientCompleted", (patientName) => {
                    console.log("✅ Patient completed:", patientName);
                    showQueueNotification('success', patientName + ' has completed their appointment');
                });

            } catch (error) {
                console.error('❌ Reception setup error:', error);
            }
        }

        function initializeDoctorConnection() {
            try {
                doctorConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect([0, 1000, 5000, 10000])
                    .build();

                doctorConnection.start()
                    .then(() => {
                        console.log("✅ Doctor connected to SignalR");
                        return doctorConnection.invoke("JoinDoctorRoom", 'current-doctor');
                    })
                    .then(() => {
                        console.log("✅ Doctor joined room successfully");
                    })
                    .catch(err => {
                        console.error('❌ Doctor Connection Error: ', err);
                    });

                doctorConnection.on("UpdateQueue", (queue) => {
                    console.log("👨‍⚕️ Doctor queue updated:", queue);
                    updateDoctorQueueDisplay(queue);
                });

                doctorConnection.on("NextPatientCalled", (patientName, appointmentId) => {
                    console.log("📢 Next patient called:", patientName);
                    showDoctorNotification('info', 'Now serving: ' + patientName);
                });

            } catch (error) {
                console.error('❌ Doctor setup error:', error);
            }
        }

        function initializeQueueButtons() {
            $(document).off('click', '.add-to-queue-btn').on('click', '.add-to-queue-btn', function () {
                const $btn = $(this);
                const appointmentId = $btn.data('appointment-id');
                const patientName = $btn.data('patient-name');
                const $row = $btn.closest('tr');

                console.log('🔄 Adding to queue:', patientName, appointmentId);

                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin me-1"></i> Adding...');

                // إخفاء الصف فوراً من الجدول
                $row.addClass('hidden-row');

                $.post('@Url.Action("AddToQueue", "Notifications")', { appointmentId: appointmentId })
                    .done(function (response) {
                        console.log('✅ Add to queue response:', response);

                        if (response.success) {
                            $btn.removeClass('btn-success').addClass('btn-outline-info');
                            $btn.html('<i class="fas fa-clock me-1"></i> In Queue');
                            $('#status-' + appointmentId).removeClass('bg-warning').addClass('bg-info').text('Notified');
                            showNotification('success', patientName + ' added to waiting queue');
                        } else {
                            showNotification('error', response.message || 'Failed to add to queue');
                            $btn.prop('disabled', false).html('<i class="fas fa-plus me-1"></i> Add to Queue');
                            $row.removeClass('hidden-row');
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error('❌ Add to queue failed:', error);
                        showNotification('error', 'Failed to add to queue: ' + error);
                        $btn.prop('disabled', false).html('<i class="fas fa-plus me-1"></i> Add to Queue');
                        $row.removeClass('hidden-row');
                    });
            });
        }

        function updateReceptionQueueDisplay(queue) {
            const $queueList = $('#queueList');
            const $emptyQueue = $('#emptyQueueState');

            console.log('🔄 Updating reception queue display:', queue);

            if (!queue || queue.length === 0) {
                console.log('📭 Queue is empty');
                $queueList.html('');
                $emptyQueue.removeClass('d-none');
                updateQueueCounters(0, 0, 0);

                // إظهار كل الصفوف في الجدول لما الطابور بيكون فاضي
                $('tr[id^="appointment-"]').removeClass('hidden-row');
                return;
            }

            $emptyQueue.addClass('d-none');

            let html = '';
            let waitingCount = 0;
            let completedCount = 0;
            const queueAppointmentIds = [];

            queue.forEach(function(patient, index) {
                const appointmentId = patient.AppointmentId || patient.appointmentId;
                if (appointmentId) {
                    queueAppointmentIds.push(appointmentId.toString());
                }

                const patientName = patient.PatientName || patient.patientName || 'Unknown';
                const appointmentTime = patient.AppointmentTime || patient.appointmentTime || '--';
                const arrivalTime = patient.ArrivalTime || patient.arrivalTime || '--';
                const status = patient.Status || patient.status || 'Waiting';
                const queueNumber = patient.QueueNumber || patient.queueNumber || (index + 1);

                const isWaiting = status === 'Waiting';
                const isInProgress = status === 'In Progress';
                const isCompleted = status === 'Completed';

                if (isWaiting) waitingCount++;
                if (isCompleted) completedCount++;

                let statusBadge = '';
                if (isWaiting) statusBadge = 'bg-warning';
                else if (isInProgress) statusBadge = 'bg-primary';
                else statusBadge = 'bg-success';

                let buttonHtml = '';
                if (isCompleted) {
                    buttonHtml = '<button class="btn btn-outline-success btn-sm" disabled><i class="fas fa-check me-1"></i> Completed</button>';
                } else if (isInProgress) {
                    buttonHtml = `<button class="btn btn-success btn-sm me-1" onclick="callNextPatient('${appointmentId}')">
                                 <i class="fas fa-check me-1"></i> Complete & Next
                                 </button>`;
                } else {
                    buttonHtml = `<button class="btn btn-primary btn-sm me-1" onclick="callNextPatient('${appointmentId}')">
                                 <i class="fas fa-check me-1"></i> Complete
                                 </button>
                                 <button class="btn btn-outline-danger btn-sm" onclick="removeFromQueue('${appointmentId}')">
                                 <i class="fas fa-times"></i>
                                 </button>`;
                }

                html += `<div class="queue-item card mb-2 ${isInProgress ? 'border-primary' : ''} ${isCompleted ? 'border-success' : ''}">
                        <div class="card-body py-2">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <div class="d-flex align-items-center">
                                        <span class="queue-number badge ${isInProgress ? 'bg-primary' : isCompleted ? 'bg-success' : 'bg-secondary'} me-2">
                                            #${queueNumber}
                                        </span>
                                        <strong>${patientName}</strong>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <small class="text-muted">Appt: ${appointmentTime}</small>
                                </div>
                                <div class="col-md-2">
                                    <small class="text-muted">Arrived: ${arrivalTime}</small>
                                </div>
                                <div class="col-md-2">
                                    <span class="badge ${statusBadge}">${status}</span>
                                </div>
                                <div class="col-md-3 text-end">
                                    ${buttonHtml}
                                </div>
                            </div>
                        </div>
                    </div>`;
            });

            $queueList.html(html);
            updateQueueCounters(queue.length, waitingCount, completedCount);
            updateAppointmentsTableVisibility(queueAppointmentIds);
        }        function updateDoctorQueueDisplay(queue) {
            console.log('🔄 Updating doctor queue display:', queue);

            if (!queue) {
                $('#doctorWaitingState').removeClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                $('#doctorQueueList').html('');
                return;
            }

            const waitingPatients = queue.filter(p => p.Status === 'Waiting');
            const currentPatient = queue.find(p => p.Status === 'In Progress');

            $('#waitingPatientsCount').text(waitingPatients.length + ' Waiting');

            if (currentPatient) {
                showCurrentPatient(currentPatient);
            } else if (waitingPatients.length > 0) {
                $('#doctorWaitingState').addClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                showNextPatientPrompt(waitingPatients[0]);
            } else {
                $('#doctorWaitingState').removeClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                $('#doctorQueueList').html('');
            }

            updateDoctorQueueList(waitingPatients);
        }
                // دالة Call Next Patient
        function callNextPatient(appointmentId) {
            console.log('✅ Completing patient and calling next:', appointmentId);

            const url = '@Url.Action("CallNextPatient", "Notifications")';
            console.log('📤 Sending to URL:', url);

            $.post(url, { appointmentId: appointmentId })
                .done(function (response) {
                    console.log('✅ Call next patient response:', response);
                    if (response.success) {
                        showQueueNotification('success', 'Patient completed successfully');

                        // الـ Queue هتتحدث تلقائياً عن طريق SignalR
                    } else {
                        console.error('❌ Call next patient failed:', response.message);
                        showQueueNotification('error', response.message || 'Failed to complete patient');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Call next patient failed:', error);
                    console.log('📋 Response details:', xhr.responseText);
                    showQueueNotification('error', 'Failed to complete patient: ' + error);
                });
        }
                // في initializeReceptionConnection
        receptionConnection.on("CallNextAndComplete", (appointmentId) => {
            console.log("🎯 CallNextAndComplete event received:", appointmentId);
            // الـ Queue هتتحدث تلقائياً عن طريق UpdateQueue
        });

        // في initializeDoctorConnection
        doctorConnection.on("CallNextAndComplete", (appointmentId) => {
            console.log("🎯 CallNextAndComplete event received for doctor:", appointmentId);
            // الـ Queue هتتحدث تلقائياً عن طريق UpdateQueue
        });

        receptionConnection.on("NextPatientReady", (patientName, appointmentId, queueNumber) => {
            console.log("⏭️ Next patient ready:", patientName);
            showQueueNotification('info', 'Next patient ready: ' + patientName);
        });

        doctorConnection.on("NextPatientReady", (patientName, appointmentId, queueNumber) => {
            console.log("⏭️ Next patient ready for doctor:", patientName);
            showDoctorNotification('info', 'Next patient ready: ' + patientName);
        });
        // دالة Complete Patient
        function completePatient(appointmentId) {
            console.log('✅ Completing patient:', appointmentId);

            $.post('@Url.Action("CompletePatient", "Notifications")', { appointmentId: appointmentId })
                .done(function (response) {
                    console.log('✅ Complete patient response:', response);
                    if (response.success) {
                        showQueueNotification('success', 'Patient completed successfully');

                        // تحديث حالة المريض لـ "Completed"
                        updatePatientStatus(appointmentId, "Completed");

                        // إظهار الصف في الجدول كـ Completed
                        $(`#appointment-${appointmentId}`).removeClass('hidden-row');
                        $(`#status-${appointmentId}`).removeClass('bg-info bg-warning').addClass('bg-success').text('Completed');
                    } else {
                        showQueueNotification('error', response.message || 'Failed to complete patient');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Complete patient failed:', error);
                    showQueueNotification('error', 'Failed to complete patient: ' + error);
                });
        }

        // دالة لتحديث حالة المريض
        function updatePatientInQueue(appointmentId, newStatus) {
            console.log('🔄 Updating patient in queue:', appointmentId, newStatus);

            const $queueItems = $('.queue-item');
            let patientFound = false;

            $queueItems.each(function() {
                const $item = $(this);
                const buttons = $item.find('button');

                for (let i = 0; i < buttons.length; i++) {
                    const onclickAttr = $(buttons[i]).attr('onclick');
                    if (onclickAttr && onclickAttr.includes(appointmentId)) {
                        patientFound = true;

                        // تحديث الـ status
                        const $statusBadge = $item.find('.badge').first();
                        $statusBadge.text(newStatus);

                        if (newStatus === "Completed") {
                            $statusBadge.removeClass('bg-warning bg-primary').addClass('bg-success');

                            // إخفاء الأزرار أو جعلها non-clickable
                            $item.find('button').prop('disabled', true).addClass('btn-outline-success');
                            $item.find('button').html('<i class="fas fa-check me-1"></i> Completed');
                        }

                        break;
                    }
                }
            });

            if (!patientFound) {
                console.log('❌ Patient not found in queue');
            }
        }       
        function showCurrentPatient(patient) {
            const patientName = patient.PatientName || patient.patientName;
            const appointmentTime = patient.AppointmentTime || patient.appointmentTime;
            const arrivalTime = patient.ArrivalTime || patient.arrivalTime;
            const queueNumber = patient.QueueNumber || patient.queueNumber;

            $('#currentPatientName').text(patientName);
            $('#currentAppointmentTime').text('Appointment: ' + appointmentTime);
            $('#currentArrivalTime').text('Arrived: ' + arrivalTime);
            $('#currentPatientQueueNumber').text('Queue #' + queueNumber);
            $('#currentQueueNumber').text('#' + queueNumber);

            currentAppointmentId = patient.AppointmentId || patient.appointmentId;

            $('#doctorWaitingState').addClass('d-none');
            $('#doctorCurrentPatient').removeClass('d-none');
        }

        function showNextPatientPrompt(patient) {
            const patientName = patient.PatientName || patient.patientName;
            const appointmentTime = patient.AppointmentTime || patient.appointmentTime;
            const queueNumber = patient.QueueNumber || patient.queueNumber;

            $('#doctorQueueList').html(
                `<div class="alert alert-info">
                    <div class="d-flex align-items-center">
                        <i class="fas fa-user-clock fa-2x me-3"></i>
                        <div class="flex-grow-1">
                            <h6 class="mb-1">Next Patient Ready</h6>
                            <p class="mb-1">${patientName} is waiting</p>
                            <small class="text-muted">Queue #${queueNumber} | Appointment: ${appointmentTime}</small>
                        </div>
                        <div>
                            <button class="btn btn-primary" onclick="callNextPatient('${patient.AppointmentId || patient.appointmentId}')">
                                <i class="fas fa-play me-1"></i> Start
                            </button>
                        </div>
                    </div>
                </div>`
            );
        }

        function updateDoctorQueueList(waitingPatients) {
            if (waitingPatients.length > 0) {
                let html = '<h6 class="mb-3">Waiting Patients:</h6>';
                waitingPatients.forEach(function(patient) {
                    const patientName = patient.PatientName || patient.patientName;
                    const appointmentTime = patient.AppointmentTime || patient.appointmentTime;
                    const queueNumber = patient.QueueNumber || patient.queueNumber;

                    html += `<div class="queue-item-small card mb-2">
                            <div class="card-body py-2">
                                <div class="d-flex justify-content-between align-items-center">
                                    <div>
                                        <span class="badge bg-secondary me-2">#${queueNumber}</span>
                                        <strong>${patientName}</strong>
                                        <small class="text-muted ms-2">${appointmentTime}</small>
                                    </div>
                                    <span class="badge bg-warning">Waiting</span>
                                </div>
                            </div>
                        </div>`;
                });
                $('#doctorQueueList').html(html);
            } else {
                $('#doctorQueueList').html('');
            }
        }

                function callNextPatient(appointmentId) {
            console.log('✅ Completing patient:', appointmentId);

            const url = '@Url.Action("CallNextPatient", "Notifications")';
            console.log('📤 Sending to URL:', url);

            $.post(url, { appointmentId: appointmentId })
                .done(function (response) {
                    console.log('✅ Call next patient response:', response);
                    if (response.success) {
                        showQueueNotification('success', 'Patient completed successfully');

                        // تحديث الـ UI مباشرة لـ Completed
                        updatePatientInQueue(appointmentId, "Completed");

                        // إظهار الصف في الجدول كـ Completed
                        $(`#appointment-${appointmentId}`).removeClass('hidden-row');
                        $(`#status-${appointmentId}`).removeClass('bg-warning bg-info').addClass('bg-success').text('Completed');
                    } else {
                        console.error('❌ Call next patient failed:', response.message);
                        showQueueNotification('error', response.message || 'Failed to complete patient');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Call next patient failed:', error);
                    console.log('📋 Response details:', xhr.responseText);
                    showQueueNotification('error', 'Failed to complete patient: ' + error);
                });
        }

        // دالة Complete Patient (يمكن نحذفها أو نستخدم callNextPatient بدلها)
        function completePatient(appointmentId) {
            // نستخدم نفس دالة callNextPatient
            callNextPatient(appointmentId);
        }

        function startCurrentAppointment() {
            if (currentAppointmentId) {
                console.log('🚀 Starting appointment:', currentAppointmentId);
                window.location.href = '@Url.Action("Details", "Appointments")/' + currentAppointmentId;
            }
        }

        function updateQueueCounters(total, waiting, completed) {
            $('#totalQueueCount').text(total + ' Total');
            $('#waitingQueueCount').text(waiting + ' Waiting');
            $('#completedQueueCount').text(completed + ' Completed');
        }

        function updateAppointmentsTableVisibility(queueAppointmentIds) {
            queueAppointmentIds.forEach(appointmentId => {
                $(`#appointment-${appointmentId}`).addClass('hidden-row');
            });
        }

        function showQueueNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-danger' : 'alert-info';
            const notification = $(
                `<div class="alert ${alertClass} alert-dismissible fade show">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`
            );
            $('#queueNotifications').append(notification);
            setTimeout(() => notification.alert('close'), 5000);
        }

        function showDoctorNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-danger' : 'alert-info';
            const notification = $(
                `<div class="alert ${alertClass} alert-dismissible fade show">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`
            );
            $('.card-body').first().append(notification);
            setTimeout(() => notification.alert('close'), 5000);
        }
                function initializeReceptionConnection() {
            try {
                receptionConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect([0, 1000, 5000, 10000])
                    .build();

                receptionConnection.start()
                    .then(() => {
                        console.log("✅ Reception connected to SignalR");
                        return receptionConnection.invoke("JoinReceptionRoom");
                    })
                    .then(() => {
                        console.log("✅ Reception joined room successfully");
                    })
                    .catch(err => {
                        console.error('❌ Reception Connection Error: ', err);
                    });

                // أضيفي هذا الـ event listener الجديد
                receptionConnection.on("UpdateQueue", (queue) => {
                    console.log("🎯 UpdateQueue event received:", queue);
                    updateReceptionQueueDisplay(queue);
                });

                // أضيفي event listeners إضافية علشان نتأكد
                receptionConnection.on("AddPatientToQueue", (patientName, appointmentId, appointmentTime) => {
                    console.log("🎯 AddPatientToQueue event:", patientName, appointmentId, appointmentTime);
                });

                receptionConnection.on("ReceiveNewPatient", (patientName, appointmentId, appointmentTime, queueNumber) => {
                    console.log("🎯 ReceiveNewPatient event:", patientName, queueNumber);
                });

            } catch (error) {
                console.error('❌ Reception setup error:', error);
            }
        }
        function showNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const notification = $(
                `<div class="alert ${alertClass} alert-dismissible fade show position-fixed"
                 style="top: 20px; right: 20px; z-index: 9999;">
                    ${message}
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>`
            );
            $('body').append(notification);
            setTimeout(() => notification.alert('close'), 5000);
        }

        // استدعي الدالة لما الصفحة تتحمل
        $(document).ready(function() {
            initializeQueueSystem();
        });
                // دالة اختبار Call Next
        function testCallNext() {
            console.log('🧪 Testing Call Next...');

            // جربي مع أول patient في الـ Queue
            const $firstQueueItem = $('.queue-item').first();
            if ($firstQueueItem.length) {
                const buttons = $firstQueueItem.find('button');
                for (let i = 0; i < buttons.length; i++) {
                    const onclickAttr = $(buttons[i]).attr('onclick');
                    if (onclickAttr && onclickAttr.includes('callNextPatient')) {
                        const appointmentId = onclickAttr.match(/'([^']+)'/)?.[1];
                        if (appointmentId) {
                            console.log('🎯 Testing with appointmentId:', appointmentId);
                            callNextPatient(appointmentId);
                            return;
                        }
                    }
                }
            }

            console.log('❌ No patient found in queue for testing');
            showNotification('warning', 'No patient in queue to test with');
        }
    </script>
}