
@using Microsoft.AspNetCore.Identity
@using DentalCareManagmentSystem.Domain.Entities
@using Microsoft.AspNetCore.Localization

@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager

@{
    var requestCulture = Context.Features.Get<IRequestCultureFeature>();
    var currentCulture = requestCulture?.RequestCulture.Culture.Name ?? "en";
}

<ul class="navbar-nav">
    @if (SignInManager.IsSignedIn(User))
    {
        <li class="nav-item">
            <span class="nav-link text-dark" title="User">
                Hello @UserManager.GetUserName(User)!
            </span>
        </li>
        <li class="nav-item">
            <form id="logoutForm" class="form-inline" asp-area="Identity" asp-page="/Account/Logout" asp-route-returnUrl="@Url.Content($"~/{currentCulture}")">
                <button id="logout" type="submit" class="nav-link btn btn-link text-dark">Logout</button>
            </form>
        </li>
    }
    else
    {
        <li class="nav-item">
            <a class="nav-link text-dark" id="register" href="/@currentCulture/Identity/Account/Register">Register</a>
        </li>
        <li class="nav-item">
            <a class="nav-link text-dark" id="login" href="/@currentCulture/Identity/Account/Login">Login</a>
        </li>
    }
</ul>

