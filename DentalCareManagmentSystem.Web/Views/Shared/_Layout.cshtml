@using Microsoft.AspNetCore.Identity
@using DentalCareManagmentSystem.Domain.Entities
@using Microsoft.AspNetCore.Mvc.Localization
@inject SignInManager<User> SignInManager
@inject UserManager<User> UserManager
@inject IViewLocalizer Localizer

@{
    var isRTL = System.Globalization.CultureInfo.CurrentCulture.Name == "ar-SA";
    var textDirection = isRTL ? "rtl" : "ltr";
    var marginClass = isRTL ? "ms" : "me";
}

<!DOCTYPE html>
<html lang='@(isRTL ? "ar" : "en")' dir='@textDirection'>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="~/images/tooth.png" />

    @if (isRTL)
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.rtl.min.css" rel="stylesheet" />
    }
    else
    {
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
    }

    <link rel="stylesheet" href="~/css/mvc-grid.css" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/DentalCareManagmentSystem.Web.styles.css" asp-append-version="true" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet" />

    <title>@ViewData["Title"] - @Localizer["DentalCare_Clinic"]</title>

    <style>
        [dir="rtl"] .me-1 {
            margin-left: 0.25rem !important;
            margin-right: 0 !important;
        }

        [dir="rtl"] .me-2 {
            margin-left: 0.5rem !important;
            margin-right: 0 !important;
        }

        [dir="rtl"] .me-3 {
            margin-left: 1rem !important;
            margin-right: 0 !important;
        }

        [dir="rtl"] .ms-1 {
            margin-right: 0.25rem !important;
            margin-left: 0 !important;
        }

        [dir="rtl"] .ms-2 {
            margin-right: 0.5rem !important;
            margin-left: 0 !important;
        }

        [dir="rtl"] .ms-3 {
            margin-right: 1rem !important;
            margin-left: 0 !important;
        }

        [dir="rtl"] .text-start {
            text-align: right !important;
        }

        [dir="rtl"] .text-end {
            text-align: left !important;
        }

        [dir="rtl"] .dropdown-menu-end {
            right: auto !important;
            left: 0 !important;
        }

        #wrapper {
            display: flex;
            position: relative;
        }

        #sidebar-wrapper {
            min-height: 100vh;
            width: 250px;
            transition: all 0.3s ease;
            background: linear-gradient(180deg, #e3f2fd, #bbdefb);
            box-shadow: 2px 0 10px rgba(0,0,0,0.05);
            position: fixed;
            top: 0;
            z-index: 1000;
        }

        [dir="ltr"] #sidebar-wrapper {
            left: 0;
            right: auto;
            border-right: 1px solid #e3f2fd;
            border-left: none;
        }

        [dir="rtl"] #sidebar-wrapper {
            right: 0;
            left: auto;
            border-left: 1px solid #e3f2fd;
            border-right: none;
        }

        #page-content-wrapper {
            width: 100%;
            transition: all 0.3s ease;
        }

        [dir="ltr"] #page-content-wrapper {
            margin-left: 250px;
        }

        [dir="rtl"] #page-content-wrapper {
            margin-right: 250px;
        }

        body.sb-sidenav-toggled [dir="ltr"] #sidebar-wrapper {
            left: -250px;
        }

        body.sb-sidenav-toggled [dir="ltr"] #page-content-wrapper {
            margin-left: 0;
        }

        body.sb-sidenav-toggled [dir="rtl"] #sidebar-wrapper {
            right: -250px;
        }

        body.sb-sidenav-toggled [dir="rtl"] #page-content-wrapper {
            margin-right: 0;
        }

        .sidebar-heading {
            font-size: 20px;
            font-weight: 700;
            color: #1565c0;
            text-align: center;
            padding: 20px 10px;
            background: #fff;
            border-bottom: 1px solid #e3f2fd;
        }

        #sidebar-wrapper .list-group-item {
            border: none;
            color: #2c3e50;
            font-weight: 500;
            background: transparent;
            transition: all 0.3s;
        }

        [dir="rtl"] #sidebar-wrapper .list-group-item {
            text-align: right;
        }

        [dir="ltr"] #sidebar-wrapper .list-group-item {
            text-align: left;
        }

        [dir="rtl"] #sidebar-wrapper .list-group-item i {
            margin-left: 0.5rem;
        }

        [dir="ltr"] #sidebar-wrapper .list-group-item i {
            margin-right: 0.5rem;
        }

        #sidebar-wrapper .list-group-item:hover {
            background: #90caf9;
            color: #fff;
        }

        [dir="ltr"] #sidebar-wrapper .list-group-item:hover {
            transform: translateX(5px);
        }

    <title>@ViewData["Title"] - DentalCareManagmentSystem</title>
    <link rel="stylesheet" href="~/css/dashboard.css" />
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
   
    <link rel="stylesheet" href="~/DentalCareManagmentSystem.Web.styles.css" asp-append-version="true" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" rel="stylesheet" />
    <link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700&display=swap" rel="stylesheet">
    
    @await RenderSectionAsync("Styles", required: false)
        [dir="rtl"] #sidebar-wrapper .list-group-item:hover {
            transform: translateX(-5px);
        }

        .navbar {
            background-color: #ffffff !important;
            box-shadow: 0 2px 8px rgba(0,0,0,0.05);
            z-index: 999;
        }

        .language-dropdown .dropdown-item:hover {
            background-color: #e9ecef;
            color: #0d6efd;
        }

        .time-display {
            min-width: 120px;
        }

        .time-text {
            font-weight: bold;
        }

        .date-text {
            opacity: 0.8;
        }

        @@media (max-width: 768px) {
            #sidebar-wrapper {
                width: 100%;
            }

            [dir="ltr"] #page-content-wrapper, [dir="rtl"] #page-content-wrapper {
                margin: 0;
            }

            body.sb-sidenav-toggled [dir="ltr"] #sidebar-wrapper {
                left: -100%;
            }

            body.sb-sidenav-toggled [dir="rtl"] #sidebar-wrapper {
                right: -100%;
            }
        }
    </style>
</head>

<body>
    <div class="d-flex" id="wrapper">
        <!-- Sidebar-->
        <div class="border-end bg-white" id="sidebar-wrapper">
            <div class="sidebar-heading border-bottom bg-light d-flex align-items-center justify-content-center fw-bold">
                <i class="fas fa-tooth text-primary @marginClass-2"></i>
                @Localizer["DentalCare Clinic"]
            </div>

            <div class="list-group list-group-flush">
                <a class="list-group-item list-group-item-action p-3" asp-area="" asp-controller="Home" asp-action="Index">
                    <i class="fas fa-tachometer-alt @marginClass-2"></i>@Localizer["Dashboard"]
                </a>
                <a class="list-group-item list-group-item-action p-3" asp-area="" asp-controller="Patients" asp-action="Index">
                    <i class="fas fa-user-injured @marginClass-2"></i>@Localizer["Patients"]
                </a>

                <a class="list-group-item list-group-item-action p-3" asp-area="" asp-controller="Appointments" asp-action="Index">
                    <i class="fas fa-calendar-check @marginClass-2"></i>@Localizer["Appointments"]
                </a>

                @if (SignInManager.IsSignedIn(User) && User.IsInRole("SystemAdmin"))
                {
                    <a class="list-group-item list-group-item-action p-3" asp-area="" asp-controller="Reports" asp-action="Index">
                        <i class="fas fa-chart-bar @marginClass-2"></i>@Localizer["Reports"]
                    </a>
                    <a class="list-group-item list-group-item-action p-3" asp-area="Admin" asp-controller="PriceList" asp-action="Index">
                        <i class="fas fa-tags @marginClass-2"></i>@Localizer["Price List"]
                    </a>
                    <a class="list-group-item list-group-item-action p-3" asp-area="Admin" asp-controller="Users" asp-action="Index">
                        <i class="fas fa-users @marginClass-2"></i>@Localizer["Users"]
                    </a>
                }
            </div>
        </div>

        <!-- Page content -->
        <div id="page-content-wrapper">
            <nav class="navbar navbar-expand-lg navbar-light bg-light border-bottom">
                <div class="container-fluid">
                    <button class="btn btn-outline-primary" id="sidebarToggle">
                        <i class="fas fa-tooth"></i>
                    </button>

                    <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent">
                        <span class="navbar-toggler-icon"></span>
                    </button>

                    <div class='navbar-nav @(isRTL ? "me-3" : "ms-3")'>
                        <div class="time-display bg-dark bg-opacity-25 rounded-3 p-2 text-center border border-light border-opacity-25">
                            <div class="d-flex align-items-center justify-content-center">
                                <i class="fas fa-clock text-warning @marginClass-2"></i>
                                <div>
                                    <div class="time-text text-white fw-bold fs-6" id="navbarTime">@DateTime.Now.ToString("HH:mm")</div>
                                    <div class="date-text text-light small" id="navbarDate">@DateTime.Now.ToString("ddd, MMM dd")</div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="collapse navbar-collapse" id="navbarSupportedContent">
                        <ul class="navbar-nav ms-auto mt-2 mt-lg-0">
                            
                        <ul class='navbar-nav @(isRTL ? "me-auto" : "ms-auto") mt-2 mt-lg-0'>

                            <!--  Language Selector (يحفظ في Cookie) -->
                            <li class="nav-item dropdown language-dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="languageDropdown" role="button"
                                   data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-globe @marginClass-1"></i>
                                    @(isRTL ? "العربية" : "English")
                                </a>
                                <div class='dropdown-menu @(isRTL ? "" : "dropdown-menu-end")' aria-labelledby="languageDropdown">
                                        <form asp-area="" asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="en-US" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn w-100 text-start px-3 py-2 border-0 bg-transparent">English</button>
                                        </form>

                                        <form asp-area="" asp-controller="Home" asp-action="SetLanguage" method="post" class="dropdown-item p-0">
                                            <input type="hidden" name="culture" value="ar-SA" />
                                            <input type="hidden" name="returnUrl" value="@Context.Request.Path" />
                                            <button type="submit" class="btn w-100 text-start px-3 py-2 border-0 bg-transparent">العربية</button>
                                        </form>
                                    </div>
                            </li>

                                <li class="nav-item">
                                    <a class="nav-link text-dark" href="@Url.Action("TodaysAppointments", "Appointments", new { area = "" })">
                                        <i class="fas fa-calendar-day @marginClass-1"></i>@Localizer["Today Appointments"]
                                    </a>
                                </li>
                                <partial name="_LoginPartial" />
                        </ul>
                    </div>
                </div>
            </nav>

            <div class="container-fluid">
                @RenderBody()
            </div>
        </div>
    </div>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/6.0.25/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="/js/mvc-grid.js"></script>
    

    

    <script>
        // Sidebar toggle state
        document.getElementById("sidebarToggle").addEventListener("click", function (e) {
            e.preventDefault();
            document.body.classList.toggle("sb-sidenav-toggled");
            localStorage.setItem("sb-sidenav-toggle", document.body.classList.contains("sb-sidenav-toggled"));
        });

        // Load saved sidebar state
        if (localStorage.getItem("sb-sidenav-toggle") === "true") {
            document.body.classList.add("sb-sidenav-toggled");
        }

        // Time update
        function updateDateTime() {
            const now = new Date();
            document.getElementById('navbarTime').textContent = now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
            document.getElementById('navbarDate').textContent = now.toLocaleDateString('en-US', { weekday: 'short', month: 'short', day: '2-digit' });
        }
        updateDateTime();
        setInterval(updateDateTime, 60000);
    </script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
