@model List<DentalCareManagmentSystem.Application.DTOs.AppointmentDto>

@{
    ViewData["Title"] = "Today's Appointments";
    var isDoctor = User.IsInRole("Doctor");
    var isReceptionist = User.IsInRole("Receptionist");
}

<div class="container-fluid py-4 fade-in">

    @if (isReceptionist)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-warning shadow-sm">
                    <div class="card-header bg-warning text-dark d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-users me-2"></i>Waiting Queue
                        </h5>
                        <div>
                            <span class="badge bg-dark me-2" id="totalQueueCount">0 Total</span>
                            <span class="badge bg-info" id="waitingQueueCount">0 Waiting</span>
                            <span class="badge bg-success" id="completedQueueCount">0 Completed</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <div id="queueList" class="mb-3">
                        </div>

                        <div id="emptyQueueState" class="text-center py-4">
                            <i class="fas fa-users-slash fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No patients in queue</h4>
                            <p class="text-muted">Add patients to the waiting queue</p>
                        </div>

                        <div id="queueNotifications"></div>
                    </div>
                </div>
            </div>
        </div>
    }

    @if (isDoctor)
    {
        <div class="row mb-4">
            <div class="col-12">
                <div class="card border-primary shadow-sm">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0">
                            <i class="fas fa-user-md me-2"></i>Doctor's Panel
                        </h5>
                        <div>
                            <span class="badge bg-light text-primary me-2" id="waitingPatientsCount">0 Waiting</span>
                            <span class="badge bg-success" id="currentQueueNumber">-</span>
                        </div>
                    </div>
                    <div class="card-body">
                        <!-- حالة الانتظار -->
                        <div id="doctorWaitingState" class="text-center py-4">
                            <i class="fas fa-user-clock fa-3x text-muted mb-3"></i>
                            <h4 class="text-muted">No patients waiting</h4>
                            <p class="text-muted">You will be notified when patients arrive</p>
                        </div>

                        <div id="doctorCurrentPatient" class="d-none">
                            <div class="alert alert-success mb-3">
                                <div class="d-flex align-items-center">
                                    <i class="fas fa-user-injured fa-2x me-3"></i>
                                    <div class="flex-grow-1">
                                        <h5 class="mb-1 fw-bold" id="currentPatientName"></h5>
                                        <p class="mb-1" id="currentAppointmentTime"></p>
                                        <small class="text-muted" id="currentArrivalTime"></small>
                                        <div class="mt-2">
                                            <span class="badge bg-primary" id="currentPatientQueueNumber">Queue #1</span>
                                        </div>
                                    </div>
                                    <div class="ms-3">
                                        <button class="btn btn-success btn-lg me-2" onclick="completeCurrentPatient()">
                                            <i class="fas fa-check me-1"></i> Complete
                                        </button>
                                        <button class="btn btn-outline-primary" onclick="startCurrentAppointment()">
                                            <i class="fas fa-play me-1"></i> Start
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div id="doctorQueueList" class="mt-3">
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold text-primary mb-1">
                <i class="fas fa-calendar-day me-2"></i>Today's Appointments
            </h2>
            <p class="text-muted mb-0">@DateTime.Today.ToString("dddd, MMMM dd, yyyy")</p>
        </div>

        <div class="d-flex gap-2">
            @if (isReceptionist)
            {
                <a href="@Url.Action("Create")" class="btn btn-primary">
                    <i class="fas fa-plus me-1"></i> New Appointment
                </a>
            }
            <a href="javascript:history.back()" class="btn btn-outline-secondary">
                <i class="fas fa-arrow-left me-1"></i> Back
            </a>
        </div>
    </div>

    <div class="row mb-4">
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card primary h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Total Appointments
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count</div>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card success h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Notified
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(a => a.Status == "Notified")</div>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-bell fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card warning h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="text-xs font-weight-bold text-warning text-uppercase mb-1">
                                Scheduled
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(a => a.Status == "Scheduled")</div>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-clock fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card stats-card danger h-100">
                <div class="card-body">
                    <div class="d-flex align-items-center">
                        <div class="flex-grow-1">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Completed
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@Model.Count(a => a.Status == "Completed")</div>
                        </div>
                        <div class="flex-shrink-0">
                            <i class="fas fa-check-circle fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="empty-state text-center py-5">
            <i class="fas fa-calendar-times fa-4x text-muted mb-3"></i>
            <h4 class="text-muted">No appointments for today</h4>
            <p class="text-muted">All caught up! No appointments scheduled for today.</p>
            @if (isReceptionist)
            {
                <a href="@Url.Action("Create")" class="btn btn-primary mt-3">
                    <i class="fas fa-plus me-1"></i> Create New Appointment
                </a>
            }
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-header bg-light d-flex justify-content-between align-items-center">
                <h5 class="mb-0">
                    <i class="fas fa-list me-2"></i>Appointments List
                </h5>
                <span class="badge bg-primary">@Model.Count appointments</span>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0">
                        <thead class="table-light">
                            <tr>
                                <th><i class="fas fa-user me-1"></i> Patient</th>
                                <th><i class="fas fa-phone me-1"></i> Phone</th>
                                <th><i class="fas fa-clock me-1"></i> Time</th>
                                <th><i class="fas fa-tag me-1"></i> Status</th>
                                @if (isReceptionist)
                                {
                                    <th><i class="fas fa-bell me-1"></i> Queue Actions</th>
                                }
                                <th><i class="fas fa-actions me-1"></i> Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var appointment in Model.OrderBy(a => a.StartTime))
                            {
                                <tr class="align-middle" id="appointment-@appointment.Id">
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3">
                                                @appointment.PatientName?[0]
                                            </div>
                                            <div>
                                                <h6 class="mb-0 fw-bold">@appointment.PatientName</h6>
                                                <small class="text-muted">@appointment.Date.ToString("MMM dd, yyyy")</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-nowrap">
                                            <i class="fas fa-phone text-muted me-1"></i>
                                            @appointment.PatientPhone
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">
                                            <i class="far fa-clock me-1"></i>
                                            @appointment.StartTime.ToString(@"hh\:mm") - @appointment.EndTime.ToString(@"hh\:mm")
                                        </span>
                                    </td>
                                    <td>
                                        @{
                                            var statusClass = appointment.Status switch
                                            {
                                                "Scheduled" => "bg-warning",
                                                "Notified" => "bg-info",
                                                "Completed" => "bg-success",
                                                "Cancelled" => "bg-danger",
                                                "NoShow" => "bg-secondary",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @statusClass status-badge" id="status-@appointment.Id">
                                            @appointment.Status
                                        </span>
                                    </td>

                                    @if (isReceptionist)
                                    {
                                        <td>
                                            @if (appointment.Status == "Scheduled")
                                            {
                                                <button class="btn btn-success btn-sm add-to-queue-btn"
                                                        data-appointment-id="@appointment.Id"
                                                        data-patient-name="@appointment.PatientName">
                                                    <i class="fas fa-plus me-1"></i> Add to Queue
                                                </button>
                                            }
                                            else if (appointment.Status == "Notified")
                                            {
                                                <button class="btn btn-outline-info btn-sm" disabled>
                                                    <i class="fas fa-clock me-1"></i> In Queue
                                                </button>
                                            }
                                            else if (appointment.Status == "Completed")
                                            {
                                                <button class="btn btn-outline-success btn-sm" disabled>
                                                    <i class="fas fa-check me-1"></i> Completed
                                                </button>
                                            }
                                        </td>
                                    }

                                    <td>
                                        <div class="btn-group btn-group-sm">
                                            <a href="@Url.Action("Details", new { id = appointment.Id })"
                                               class="btn btn-outline-primary"
                                               title="View Details">
                                                <i class="fas fa-eye"></i>
                                            </a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    }
</div>

@section Scripts {
    <script>
        // تعريف المتغيرات
        let receptionConnection = null;
        let doctorConnection = null;
        let currentAppointmentId = null;
        let currentQueueItem = null;

        $(document).ready(function () {
            console.log('✅ Page loaded, initializing connections...');

            // التأكد من تحميل SignalR
            if (typeof signalR === 'undefined') {
                console.error('❌ SignalR not loaded');
                showNotification('error', 'SignalR not loaded. Please refresh the page.');
                return;
            }

            @if (isReceptionist)
            {
                    <text>
                    console.log('👩‍💼 Initializing reception connection...');
                    initializeReceptionConnection();
                    </text>
            }

            @if (isDoctor)
            {
                    <text>
                    console.log('👨‍⚕️ Initializing doctor connection...');
                    initializeDoctorConnection();
                    </text>
            }

            // إعداد أزرار الإضافة للطابور
            initializeQueueButtons();
        });

        function initializeReceptionConnection() {
            try {
                receptionConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect([0, 1000, 5000, 10000])
                    .build();

                receptionConnection.start()
                    .then(() => {
                        console.log("✅ Reception connected to SignalR");
                        return receptionConnection.invoke("JoinReceptionRoom");
                    })
                    .then(() => {
                        console.log("✅ Reception joined room successfully");
                    })
                    .catch(err => {
                        console.error('❌ Reception Connection Error: ', err);
                        showNotification('error', 'Failed to connect to reception service');
                    });

                // استقبال تحديثات الطابور
                receptionConnection.on("UpdateQueue", (queue) => {
                    console.log("📋 Queue updated:", queue);
                    updateReceptionQueueDisplay(queue);
                });

                receptionConnection.on("PatientCompleted", (patientName) => {
                    console.log("✅ Patient completed:", patientName);
                    showQueueNotification('success', patientName + ' has completed their appointment');
                });

                receptionConnection.on("ReceiveNewPatient", (patientName, appointmentId, appointmentTime, queueNumber) => {
                    console.log("🆕 New patient received:", patientName);
                    showQueueNotification('info', patientName + ' added to queue (# ' + queueNumber + ')');
                });

                receptionConnection.on("NextPatientReady", (patientName, appointmentId, queueNumber) => {
                    console.log("⏭️ Next patient ready:", patientName);
                    showQueueNotification('warning', 'Next patient ready: ' + patientName);
                });

            } catch (error) {
                console.error('❌ Reception setup error:', error);
                showNotification('error', 'Reception setup failed: ' + error.message);
            }
        }

        function initializeDoctorConnection() {
            try {
                doctorConnection = new signalR.HubConnectionBuilder()
                    .withUrl("/notificationHub")
                    .withAutomaticReconnect([0, 1000, 5000, 10000])
                    .build();

                doctorConnection.start()
                    .then(() => {
                        console.log("✅ Doctor connected to SignalR");
                        return doctorConnection.invoke("JoinDoctorRoom", 'current-doctor');
                    })
                    .then(() => {
                        console.log("✅ Doctor joined room successfully");
                    })
                    .catch(err => {
                        console.error('❌ Doctor Connection Error: ', err);
                        showNotification('error', 'Failed to connect to doctor service');
                    });

                doctorConnection.on("UpdateQueue", (queue) => {
                    console.log("👨‍⚕️ Doctor queue updated:", queue);
                    updateDoctorQueueDisplay(queue);
                });

                doctorConnection.on("NextPatientCalled", (patientName, appointmentId) => {
                    console.log("📢 Next patient called:", patientName);
                    showDoctorNotification('info', 'Now serving: ' + patientName);
                });

                doctorConnection.on("ReceiveNewPatient", (patientName, appointmentId, appointmentTime, queueNumber) => {
                    console.log("🆕 New patient for doctor:", patientName);
                    showDoctorNotification('info', 'New patient in queue: ' + patientName + ' (# ' + queueNumber + ')');
                });

                doctorConnection.on("PatientCompleted", (patientName) => {
                    console.log("✅ Patient completed for doctor:", patientName);
                    showDoctorNotification('success', patientName + ' has completed their appointment');
                });

            } catch (error) {
                console.error('❌ Doctor setup error:', error);
                showNotification('error', 'Doctor setup failed: ' + error.message);
            }
        }

        function initializeQueueButtons() {
            $('.add-to-queue-btn').off('click').on('click', function () {
                const $btn = $(this);
                const appointmentId = $btn.data('appointment-id');
                const patientName = $btn.data('patient-name');
                const $row = $btn.closest('tr');

                console.log('🔄 Adding to queue:', patientName, appointmentId);

                $btn.prop('disabled', true);
                $btn.html('<i class="fas fa-spinner fa-spin me-1"></i> Adding...');

                // إخفاء الصف فوراً علشان يختفي من الجدول
                $row.addClass('hidden-row');

                // استخدام الـ Controller الصحيح
                $.post('@Url.Action("AddToQueue", "Notifications")', { appointmentId: appointmentId })
                    .done(function (response) {
                        console.log('✅ Add to queue response:', response);

                        if (response.success) {
                            $btn.removeClass('btn-success').addClass('btn-outline-info');
                            $btn.html('<i class="fas fa-clock me-1"></i> In Queue');
                            $('#status-' + appointmentId).removeClass('bg-warning').addClass('bg-info').text('Notified');
                            showNotification('success', patientName + ' added to waiting queue');

                            // الصف مختفي بالفعل من الخطوة السابقة
                        } else {
                            showNotification('error', response.message || 'Failed to add to queue');
                            $btn.prop('disabled', false).html('<i class="fas fa-plus me-1"></i> Add to Queue');
                            $row.removeClass('hidden-row'); // إرجاع الصف إذا فشلت الإضافة
                        }
                    })
                    .fail(function (xhr, status, error) {
                        console.error('❌ Add to queue failed:', error);
                        showNotification('error', 'Failed to add to queue: ' + error);
                        $btn.prop('disabled', false).html('<i class="fas fa-plus me-1"></i> Add to Queue');
                        $row.removeClass('hidden-row'); // إرجاع الصف إذا فشلت الإضافة
                    });
            });
        }
        function updateReceptionQueueDisplay(queue) {
            const $queueList = $('#queueList');
            const $emptyQueue = $('#emptyQueueState');

            console.log('🔄 Updating reception queue display:', queue);

            if (!queue || queue.length === 0) {
                console.log('📭 Queue is empty');
                $queueList.html('');
                $emptyQueue.removeClass('d-none');
                updateQueueCounters(0, 0, 0);

                // إظهار كل الصفوف في الجدول لما الطابور بيكون فاضي
                $('tr[id^="appointment-"]').removeClass('hidden-row');
                return;
            }

            $emptyQueue.addClass('d-none');

            let html = '';
            let waitingCount = 0;
            let completedCount = 0;

            // مجموعة الـ appointment IDs اللي في الطابور
            const queueAppointmentIds = [];

            queue.forEach(function(patient, index) {
                // جمع الـ IDs علشان نخفيها من الجدول
                const appointmentId = patient.AppointmentId || patient.appointmentId;
                if (appointmentId) {
                    queueAppointmentIds.push(appointmentId.toString());
                }

                // استخدمي الأسماء الصحيحة للخصائص
                const patientName = patient.PatientName || patient.patientName || 'Unknown';
                const appointmentTime = patient.AppointmentTime || patient.appointmentTime || '--';
                const arrivalTime = patient.ArrivalTime || patient.arrivalTime || '--';
                const status = patient.Status || patient.status || 'Waiting';
                const queueNumber = patient.QueueNumber || patient.queueNumber || (index + 1);
                const completedTime = patient.CompletedTime || patient.completedTime;

                const isWaiting = status === 'Waiting';
                const isInProgress = status === 'In Progress';
                const isCompleted = status === 'Completed';

                if (isWaiting) waitingCount++;
                if (isCompleted) completedCount++;

                let statusBadge = '';
                if (isWaiting) statusBadge = 'bg-warning';
                else if (isInProgress) statusBadge = 'bg-primary';
                else statusBadge = 'bg-success';

                let buttonHtml = '';
                if (isCompleted) {
                    buttonHtml = `<small class="text-success">Completed: ${completedTime || '--'}</small>`;
                } else {
                    const isDisabled = !isWaiting ? 'disabled' : '';
                    const buttonClass = isInProgress ? 'btn-success' : 'btn-outline-secondary';
                    const buttonText = isWaiting ? 'Call Next' : 'In Progress';
                    buttonHtml = `<button class="btn btn-sm ${buttonClass}" onclick="callNextPatient('${appointmentId}')" ${isDisabled}>
                                 <i class="fas fa-bullhorn me-1"></i> ${buttonText}
                                 </button>`;
                }

                html += `<div class="queue-item card mb-2 ${isInProgress ? 'border-primary' : ''} ${isCompleted ? 'border-success' : ''}">
                        <div class="card-body py-2">
                            <div class="row align-items-center">
                                <div class="col-md-3">
                                    <div class="d-flex align-items-center">
                                        <span class="queue-number badge ${isInProgress ? 'bg-primary' : isCompleted ? 'bg-success' : 'bg-secondary'} me-2">
                                            #${queueNumber}
                                        </span>
                                        <strong>${patientName}</strong>
                                    </div>
                                </div>
                                <div class="col-md-2">
                                    <small class="text-muted">Appt: ${appointmentTime}</small>
                                </div>
                                <div class="col-md-2">
                                    <small class="text-muted">Arrived: ${arrivalTime}</small>
                                </div>
                                <div class="col-md-2">
                                    <span class="badge ${statusBadge}">${status}</span>
                                </div>
                                <div class="col-md-3 text-end">
                                    ${buttonHtml}
                                    ${!isCompleted ? `<button class="btn btn-outline-danger btn-sm ms-1" onclick="removeFromQueue('${appointmentId}')">
                                        <i class="fas fa-times"></i>
                                    </button>` : ''}
                                </div>
                            </div>
                        </div>
                    </div>`;
            });

            $queueList.html(html);
            updateQueueCounters(queue.length, waitingCount, completedCount);

            // إخفاء الصفوف اللي في الطابور من الجدول
            updateAppointmentsTableVisibility(queueAppointmentIds);

            console.log('✅ Queue display updated successfully');
            console.log('📋 Hidden appointments:', queueAppointmentIds);
        }

        // دالة لتحديث ظهور/إخفاء الصفوف في الجدول
        function updateAppointmentsTableVisibility(queueAppointmentIds) {
            // إخفاء كل الصفوف اللي في الطابور
            queueAppointmentIds.forEach(appointmentId => {
                $(`#appointment-${appointmentId}`).addClass('hidden-row');
            });

            // إظهار الصفوف اللي مش في الطابور
            $('tr[id^="appointment-"]').each(function() {
                const rowId = $(this).attr('id');
                const appointmentId = rowId.replace('appointment-', '');

                if (!queueAppointmentIds.includes(appointmentId)) {
                    $(this).removeClass('hidden-row');
                }
            });
        }
        function updateDoctorQueueDisplay(queue) {
            console.log('🔄 Updating doctor queue display:', queue);

            if (!queue) {
                $('#doctorWaitingState').removeClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                $('#doctorQueueList').html('');
                return;
            }

            const waitingPatients = queue.filter(function(p) { return p.status === 'Waiting'; });
            const currentPatient = queue.find(function(p) { return p.status === 'In Progress'; });
            const completedPatients = queue.filter(function(p) { return p.status === 'Completed'; });

            $('#waitingPatientsCount').text(waitingPatients.length + ' Waiting');

            if (currentPatient) {
                showCurrentPatient(currentPatient);
            } else if (waitingPatients.length > 0) {
                $('#doctorWaitingState').addClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                showNextPatientPrompt(waitingPatients[0]);
            } else {
                $('#doctorWaitingState').removeClass('d-none');
                $('#doctorCurrentPatient').addClass('d-none');
                $('#doctorQueueList').html('');
            }

            updateDoctorQueueList(waitingPatients);
        }

        function showCurrentPatient(patient) {
            $('#currentPatientName').text(patient.patientName);
            $('#currentAppointmentTime').text('Appointment: ' + patient.appointmentTime);
            $('#currentArrivalTime').text('Arrived: ' + patient.arrivalTime);
            $('#currentPatientQueueNumber').text('Queue #' + patient.queueNumber);
            $('#currentQueueNumber').text('#' + patient.queueNumber);

            currentAppointmentId = patient.appointmentId;
            currentQueueItem = patient;

            $('#doctorWaitingState').addClass('d-none');
            $('#doctorCurrentPatient').removeClass('d-none');
        }

        function showNextPatientPrompt(patient) {
            $('#doctorQueueList').html(
                '<div class="alert alert-info">' +
                '<div class="d-flex align-items-center">' +
                '<i class="fas fa-user-clock fa-2x me-3"></i>' +
                '<div class="flex-grow-1">' +
                '<h6 class="mb-1">Next Patient Ready</h6>' +
                '<p class="mb-1">' + patient.patientName + ' is waiting</p>' +
                '<small class="text-muted">Queue #' + patient.queueNumber + ' | Appointment: ' + patient.appointmentTime + '</small>' +
                '</div>' +
                '<div>' +
                '<button class="btn btn-primary" onclick="callNextPatient()">' +
                '<i class="fas fa-play me-1"></i> Start' +
                '</button>' +
                '</div>' +
                '</div>' +
                '</div>'
            );
        }

        function updateDoctorQueueList(waitingPatients) {
            if (waitingPatients.length > 0) {
                let html = '<h6 class="mb-3">Waiting Patients:</h6>';
                waitingPatients.forEach(function(patient) {
                    html += '<div class="queue-item-small card mb-2">' +
                            '<div class="card-body py-2">' +
                            '<div class="d-flex justify-content-between align-items-center">' +
                            '<div>' +
                            '<span class="badge bg-secondary me-2">#' + patient.queueNumber + '</span>' +
                            '<strong>' + patient.patientName + '</strong>' +
                            '<small class="text-muted ms-2">' + patient.appointmentTime + '</small>' +
                            '</div>' +
                            '<span class="badge bg-warning">Waiting</span>' +
                            '</div>' +
                            '</div>' +
                            '</div>';
                });
                $('#doctorQueueList').html(html);
            } else {
                $('#doctorQueueList').html('');
            }
        }

        function callNextPatient() {
            console.log('📢 Calling next patient...');

            $.post('@Url.Action("CallNextPatient", "Notifications")')
                .done(function (response) {
                    console.log('✅ Call next patient response:', response);
                    if (response.success) {
                        showQueueNotification('info', 'Next patient called');
                    } else {
                        showQueueNotification('error', response.message || 'Failed to call next patient');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Call next patient failed:', error);
                    showQueueNotification('error', 'Failed to call next patient: ' + error);
                });
        }

        function completeCurrentPatient() {
            if (currentAppointmentId) {
                console.log('✅ Completing patient:', currentAppointmentId);

                $.post('@Url.Action("CompletePatient", "Notifications")', {
                    appointmentId: currentAppointmentId
                }).done(function(response) {
                    console.log('✅ Complete patient response:', response);
                    if (response.success) {
                        showDoctorNotification('success', 'Patient completed successfully');
                        currentAppointmentId = null;
                        currentQueueItem = null;
                    } else {
                        showDoctorNotification('error', response.message || 'Failed to complete patient');
                    }
                }).fail(function(xhr, status, error) {
                    console.error('❌ Complete patient failed:', error);
                    showDoctorNotification('error', 'Failed to complete patient: ' + error);
                });
            }
        }

        function startCurrentAppointment() {
            if (currentAppointmentId) {
                console.log('🚀 Starting appointment:', currentAppointmentId);
                window.location.href = '@Url.Action("Details", "Appointments")/' + currentAppointmentId;
            }
        }

        function updateQueueCounters(total, waiting, completed) {
            $('#totalQueueCount').text(total + ' Total');
            $('#waitingQueueCount').text(waiting + ' Waiting');
            $('#completedQueueCount').text(completed + ' Completed');
        }

        function showQueueNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-danger' : 'alert-info';
            const notification = $(
                '<div class="alert ' + alertClass + ' alert-dismissible fade show">' +
                message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
            $('#queueNotifications').append(notification);
            setTimeout(function() { notification.alert('close'); }, 5000);
        }

        function showDoctorNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : type === 'error' ? 'alert-danger' : 'alert-info';
            const notification = $(
                '<div class="alert ' + alertClass + ' alert-dismissible fade show">' +
                message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
            $('.card-body').first().append(notification);
            setTimeout(function() { notification.alert('close'); }, 5000);
        }

        function showNotification(type, message) {
            const alertClass = type === 'success' ? 'alert-success' : 'alert-danger';
            const notification = $(
                '<div class="alert ' + alertClass + ' alert-dismissible fade show position-fixed" ' +
                'style="top: 20px; right: 20px; z-index: 9999;">' +
                message +
                '<button type="button" class="btn-close" data-bs-dismiss="alert"></button>' +
                '</div>'
            );
            $('body').append(notification);
            setTimeout(function() { notification.alert('close'); }, 5000);
        }
                // دالة لإزالة المريض من الطابور
        function removeFromQueue(appointmentId) {
            console.log('🗑️ Removing from queue:', appointmentId);

            $.post('@Url.Action("RemoveFromQueue", "Notifications")', { appointmentId: appointmentId })
                .done(function (response) {
                    console.log('✅ Remove from queue response:', response);
                    if (response.success) {
                        showNotification('success', 'Patient removed from queue');
                        // إرجاع الحالة لـ Scheduled
                        $('#status-' + appointmentId).removeClass('bg-info').addClass('bg-warning').text('Scheduled');

                        // إظهار الصف في الجدول تاني
                        $(`#appointment-${appointmentId}`).removeClass('hidden-row');
                    } else {
                        showNotification('error', response.message || 'Failed to remove from queue');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Remove from queue failed:', error);
                    showNotification('error', 'Failed to remove from queue: ' + error);
                });
        }

        // عدلي دالة callNextPatient علشان تاخد الـ appointmentId
        function callNextPatient(appointmentId) {
            console.log('📢 Calling next patient:', appointmentId);

            $.post('@Url.Action("CallNextPatient", "Notifications")', { appointmentId: appointmentId })
                .done(function (response) {
                    console.log('✅ Call next patient response:', response);
                    if (response.success) {
                        showQueueNotification('info', 'Next patient called');
                    } else {
                        showQueueNotification('error', response.message || 'Failed to call next patient');
                    }
                })
                .fail(function (xhr, status, error) {
                    console.error('❌ Call next patient failed:', error);
                    showQueueNotification('error', 'Failed to call next patient: ' + error);
                });
        }
    </script>
}