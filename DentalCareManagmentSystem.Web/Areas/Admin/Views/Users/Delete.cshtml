@model DentalCareManagmentSystem.Application.DTOs.UserDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Delete User"];
}

<div class="container mt-5">
    <div class="card shadow-sm border-0 p-4">
        <h2 class="fw-bold text-danger mb-4">
            <i class="fas fa-trash me-2"></i> @Localizer["Delete User"]
        </h2>

        <p>@Localizer["Are you sure you want to delete this user?"]</p>

        <dl class="row">
            <dt class="col-sm-3 fw-semibold">@Localizer["Full Name"]</dt>
            <dd class="col-sm-9">@Model.FullName</dd>

            <dt class="col-sm-3 fw-semibold">@Localizer["Email"]</dt>
            <dd class="col-sm-9">@Model.Email</dd>

            <dt class="col-sm-3 fw-semibold">@Localizer["Role"]</dt>
            <dd class="col-sm-9">@Model.Role</dd>
        </dl>

        <form asp-action="Delete" method="post">
            <input type="hidden" asp-for="Id" />
            <div class="text-end mt-4">
                <a asp-action="Index" class="btn btn-secondary me-2">
                    <i class="fas fa-arrow-left"></i> @Localizer["Cancel"]
                </a>
                <button type="submit" class="btn btn-danger">
                    <i class="fas fa-trash"></i> @Localizer["Confirm Delete"]
                </button>
            </div>
        </form>
    </div>
</div>