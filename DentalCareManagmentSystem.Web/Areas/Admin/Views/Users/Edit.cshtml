@model DentalCareManagmentSystem.Application.DTOs.UserDto
@using Microsoft.AspNetCore.Mvc.Localization
@inject IViewLocalizer Localizer

@{
    ViewData["Title"] = Localizer["Edit User"];
}

<div class="container mt-5">
    <h2 class="fw-bold text-primary mb-4"><i class="fas fa-edit me-2"></i> @Localizer["Edit User"]</h2>

    <form asp-action="Edit" method="post">
        <div class="card shadow-sm border-0 p-4">
            <input type="hidden" asp-for="Id" />

            <div class="row g-3">
                <div class="col-md-6">
                    <label asp-for="FullName" class="form-label fw-semibold"><i class="fas fa-user"></i> @Localizer["Full Name"]</label>
                    <input asp-for="FullName" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Email" class="form-label fw-semibold"><i class="fas fa-envelope"></i> @Localizer["Email"]</label>
                    <input asp-for="Email" class="form-control" />
                </div>

                <div class="col-md-6">
                    <label asp-for="Role" class="form-label fw-semibold"><i class="fas fa-user-tag"></i> @Localizer["Role"]</label>
                    <select asp-for="Role" asp-items="ViewBag.Roles" class="form-select"></select>
                </div>
            </div>

            <div class="mt-4 text-end">
                <a asp-action="Index" class="btn btn-outline-secondary me-2"><i class="fas fa-arrow-left"></i> @Localizer["Cancel"]</a>
                <button type="submit" class="btn btn-primary"><i class="fas fa-save"></i> @Localizer["Save Changes"]</button>
            </div>
        </div>
    </form>
</div>